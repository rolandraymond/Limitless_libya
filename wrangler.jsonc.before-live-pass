{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "limitless-libya-event",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-09-13",
	"keep_vars": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"observability": {
  "logs": {
    "enabled": true,
    "invocation_logs": true
  }
},
	"d1_databases": [
	{
		"binding": "DB",
		"database_name": "limitless-libya-db",
		"database_id": "688eec28-9626-4c80-b7d2-83373743fe16"
	}
	],
	"vars": {
		"ADMIN_USERNAME": "admin",
		"EMAIL_FROM": "Limitless Naturals <invitation@mail.tungsten-media.online>",
		"PUBLIC_APP_URL": "https://limitless-libya-event.rolandremon300.workers.dev"
	}
}